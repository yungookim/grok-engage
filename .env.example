# grok-engage Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development
OPEN_BROWSER=true

# Database
DB_PATH=./data/monitor.db

# X API Credentials (get from developer.x.com)
# Required for searching tweets and posting replies
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# xAI API (get from x.ai)
# Required for semantic scoring and reply generation
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-latest

# Encryption (optional - for storing credentials in DB)
# If not set, credentials must be provided via environment variables
# Generate a strong random key if you want to store credentials in the database
MASTER_KEY=
